{
  "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/build",
  "latex-workshop.latex.tools": [
    {
      "name": "build-three-papers",
      "command": "python3",
      "args": [
        "%WORKSPACE_FOLDER%/scripts/build_papers.py"
      ],
      "cwd": "%WORKSPACE_FOLDER%"
    },
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-outdir=%WORKSPACE_FOLDER%/build",
        "%DOC%"
      ],
      "cwd": "%WORKSPACE_FOLDER%"
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "LuaLaTeX: all three papers with cross-references",
      "tools": [
        "build-three-papers"
      ]
    },
    {
      "name": "LuaLaTeX (latexmk)",
      "tools": [
        "latexmk"
      ]
    }
  ],
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.synctex.afterBuild.enabled": true
}
